{
  "name": "okf-skills",
  "version": "1.6.0",
  "description": "Agent skills, CLI utilities, and automation for the Open Knowledge Format (OKF)",
  "main": "okf-lint/scripts/lint.js",
  "scripts": {
    "test": "node scripts/test-lifecycle.js",
    "okf:lint": "node okf-lint/scripts/lint.js",
    "okf:lint:drift": "node okf-lint/scripts/lint.js --drift",
    "okf:lint:strict": "node okf-lint/scripts/lint.js --strict-links",
    "okf:maintain": "node okf-maintain/scripts/maintain.js",
    "okf:maintain:check": "node okf-maintain/scripts/maintain.js --check",
    "okf:viz": "node okf-visualize/scripts/visualize.js --bundle docs/okf",
    "okf:query": "node okf-query/scripts/query.js",
    "okf:upgrade": "node okf-upgrade/scripts/upgrade.js",
    "okf:prune": "node okf-prune/scripts/prune.js",
    "okf:prune:check": "node okf-prune/scripts/prune.js --check"
  },
  "keywords": [
    "okf",
    "knowledge-format",
    "agent-skills",
    "documentation",
    "context-engineering"
  ],
  "author": "Google Cloud Platform / Community",
  "license": "Apache-2.0"
}
